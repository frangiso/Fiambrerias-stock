rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function rolUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return estaLogueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && rolUsuario() == 'admin';
    }

    // Evita que un usuario registre una acción a nombre de otro:
    // si el doc trae 'registradoPor', tiene que coincidir con el
    // email de la sesión autenticada actual.
    function registradoPorPropio() {
      return !('registradoPor' in request.resource.data)
        || request.resource.data.registradoPor == request.auth.token.email;
    }

    // Permite que una escritura solo toque ciertos campos. Se usa para
    // dejar que un cajero (no-admin) descuente stock al vender o acumule
    // saldo de un fiado, sin poder tocar precio, costo, nombre, etc.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------------------------------------------------------------
    // usuarios: cada usuario puede crear (una sola vez) su propio doc
    // como 'cajero'. Ascender a admin (o degradar) solo lo puede hacer
    // otro admin. Nadie puede auto-ascenderse.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if estaLogueado();
      allow create: if estaLogueado()
        && request.auth.uid == uid
        && request.resource.data.rol == 'cajero';
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------
    // productos: cualquier usuario logueado puede leer (lo necesita
    // el cajero para vender). Un cajero (no-admin) solo puede tocar el
    // campo 'stock' (lo hace una venta al descontar), nunca precio,
    // costo ni nombre. Crear productos, editarlos a fondo o borrarlos
    // es exclusivo de admin.
    // ---------------------------------------------------------------
    match /productos/{id} {
      allow read: if estaLogueado();
      allow create: if esAdmin() && registradoPorPropio();
      allow update: if estaLogueado() && registradoPorPropio()
        && (esAdmin() || soloCambia(['stock']));
      allow delete: if esAdmin();
    }

    // rubros / recetas: lectura libre (el cajero necesita leer recetas
    // para vender productos compuestos). Altas y ediciones solo admin.
    match /rubros/{id} {
      allow read: if estaLogueado();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /recetas/{id} {
      allow read: if estaLogueado();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------
    // ventas: se crean al vender. Nunca se borran. La única
    // modificación permitida es la anulación (marcar anulada:true),
    // reservada a admin, para que quede registrado quién y por qué.
    // ---------------------------------------------------------------
    match /ventas/{id} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() && registradoPorPropio();
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulada', 'motivoAnulacion', 'anuladaPor', 'anuladaFecha']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // movimientos: registro de auditoría de stock (ventas, compras,
    // anulaciones, mermas). Solo se crean, nunca se editan ni borran.
    // ---------------------------------------------------------------
    match /movimientos/{id} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() && registradoPorPropio();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // caja: registro de auditoría de ingresos/egresos/cierres. Solo
    // se crean documentos nuevos (incluso las anulaciones y cierres
    // de caja se guardan como nuevo movimiento), nunca se editan ni
    // borran, para mantener el arqueo confiable.
    // ---------------------------------------------------------------
    match /caja/{id} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() && registradoPorPropio();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // compras: el cajero no gestiona compras (no tiene acceso a esa
    // pantalla). Solo admin puede crear, editar o borrar.
    // ---------------------------------------------------------------
    match /compras/{id} {
      allow read: if estaLogueado();
      allow create, update: if esAdmin() && registradoPorPropio();
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------
    // clientes (cuenta corriente / fiado): lectura libre (el cajero
    // necesita ver la lista para elegir a quién fiarle). Crear clientes
    // nuevos o editar nombre/teléfono es solo admin. Un cajero sí puede
    // tocar el campo 'saldo' (lo hace una venta fiada al sumar deuda).
    // Borrar solo admin.
    // ---------------------------------------------------------------
    match /clientes/{id} {
      allow read: if estaLogueado();
      allow create: if esAdmin() && registradoPorPropio();
      allow update: if estaLogueado() && registradoPorPropio()
        && (esAdmin() || soloCambia(['saldo']));
      allow delete: if esAdmin();
    }

    // ---------------------------------------------------------------
    // notificaciones: avisos para el admin (ej. apertura de caja con
    // saldo distinto al cierre anterior). Cualquier usuario logueado
    // puede crear una a su propio nombre; solo el admin puede leerlas
    // y marcarlas como leídas.
    // ---------------------------------------------------------------
    match /notificaciones/{id} {
      allow read: if esAdmin();
      allow create: if estaLogueado()
        && request.resource.data.creadaPor == request.auth.token.email;
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if false;
    }

    // Por defecto, todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
